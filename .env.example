# ── Gmail SMTP (booking notifications) ────────────────────────────
# 1. Turn on 2-Step Verification on the Google account
# 2. Google Account → Security → App passwords → create one for "Mail"
# 3. Paste the 16-character password below (remove the spaces)
GMAIL_USER=legacyconsultingllc2022@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Where booking and enquiry emails are delivered. Defaults to GMAIL_USER if blank.
BOOKING_RECIPIENT=legacyconsultingllc2022@gmail.com

# Public site URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://legacymarketingandconsultingllc.com
